{
  // AI 健身教練：純靜態 PWA，部署到 Cloudflare Workers Static Assets（免費層）。
  // 沒有 Worker 程式碼、沒有任何 binding；所有運算與資料都在使用者瀏覽器內。
  // 部署：npm run build && npx wrangler deploy
  "name": "ai-fitness-coach",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // App 內部連結與 service worker 預先快取都用 xxx.html；預設的 auto-trailing-slash 會把
    // /train.html 307 轉址到 /train，SW 快取到轉址回應後頁面會載入失敗，所以關閉自動轉址。
    "html_handling": "none",
    // html_handling none 之後 / 不會自動對到 index.html；用 SPA 模式讓找不到的導覽請求回首頁。
    "not_found_handling": "single-page-application"
  }
}
